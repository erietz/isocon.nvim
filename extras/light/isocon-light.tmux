# Isocon Light theme for tmux

set -g status-style "bg=#eef3ea,fg=#6e6e6e"
set -g message-style "bg=#dadfd6,fg=#6e6e6e"
set -g message-command-style "bg=#dadfd6,fg=#6e6e6e"
set -g mode-style "bg=#6e6e6e,fg=#eef3ea"
set -g pane-border-style "fg=#e7ece3"
set -g pane-active-border-style "fg=#2f6bcf"
set -g window-status-current-style "fg=#2f6bcf,bold"
set -g window-status-style "fg=#6e6e6e"
