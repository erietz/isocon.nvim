# Isocon Dark theme for tmux

set -g status-style "bg=#062329,fg=#868686"
set -g message-style "bg=#0c3241,fg=#868686"
set -g message-command-style "bg=#0c3241,fg=#868686"
set -g mode-style "bg=#868686,fg=#062329"
set -g pane-border-style "fg=#162531"
set -g pane-active-border-style "fg=#408cbd"
set -g window-status-current-style "fg=#408cbd,bold"
set -g window-status-style "fg=#868686"
